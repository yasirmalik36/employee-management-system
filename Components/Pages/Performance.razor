@page "/performance"
@inject IPerformanceService PerformanceService

<PageTitle>Performance - EMS</PageTitle>

<MudText Typo="Typo.h5" Class="font-weight-bold mb-1">Performance</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">Track employee goals and ratings</MudText>

<MudGrid Spacing="3">
    @foreach (var review in _reviews)
    {
        <MudItem xs="12" md="6">
            <MudPaper Class="section-card" Elevation="0">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                    <div>
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">@review.EmployeeName</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@review.DepartmentName &middot; @review.Month</MudText>
                    </div>
                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small">@review.Rating.ToString("0.0")/5</MudChip>
                </MudStack>

                @foreach (var goal in review.Goals)
                {
                    <MudText Typo="Typo.body2" Class="mb-1">@goal.Title</MudText>
                    <MudProgressLinear Color="@(goal.ProgressPercent >= 70 ? Color.Success : Color.Warning)" Value="@goal.ProgressPercent" Class="mb-3" Rounded="true" Size="Size.Medium" />
                }
            </MudPaper>
        </MudItem>
    }
</MudGrid>

@code {
    private List<Models.PerformanceReview> _reviews = new();

    protected override async Task OnInitializedAsync()
    {
        _reviews = await PerformanceService.GetAllAsync();
    }
}
