@page "/employees"
@inject IEmployeeService EmployeeService
@inject IDepartmentService DepartmentService
@inject IRoleService RoleService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Employees - EMS</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <div>
        <MudText Typo="Typo.h5" Class="font-weight-bold">Employees</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Manage your organization employees</MudText>
    </div>
    <MudStack Row="true" Spacing="2">
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download">Export</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Nav.NavigateTo("/employees/add"))">
            Add Employee
        </MudButton>
    </MudStack>
</MudStack>

<MudPaper Class="section-card mb-4" Elevation="0">
    <MudGrid Spacing="2">
        <MudItem xs="12" md="4">
            <MudTextField T="string" @bind-Value="_searchText" Placeholder="Search employees..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudSelect T="string" @bind-Value="_departmentFilter" Label="Department" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="@("All")">All Departments</MudSelectItem>
                @foreach (var d in _departments)
                {
                    <MudSelectItem Value="@d.Name">@d.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudSelect T="string" @bind-Value="_roleFilter" Label="Role" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="@("All")">All Roles</MudSelectItem>
                @foreach (var r in _roles)
                {
                    <MudSelectItem Value="@r.Title">@r.Title</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="2">
            <MudSelect T="string" @bind-Value="_statusFilter" Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="@("All")">All Status</MudSelectItem>
                <MudSelectItem Value="@("Active")">Active</MudSelectItem>
                <MudSelectItem Value="@("OnLeave")">On Leave</MudSelectItem>
                <MudSelectItem Value="@("Inactive")">Inactive</MudSelectItem>
            </MudSelect>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Class="section-card rounded-table" Elevation="0">
    <MudTable Items="@FilteredEmployees" Hover="true" Striped="false" Loading="@_loading" Dense="false">
        <HeaderContent>
            <MudTh>ID</MudTh>
            <MudTh>Employee</MudTh>
            <MudTh>Department</MudTh>
            <MudTh>Role</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.EmployeeCode</MudTd>
            <MudTd>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudAvatar Size="Size.Small"><MudImage Src="@context.ProfilePictureUrl" /></MudAvatar>
                    <MudText Typo="Typo.body2">@context.FullName</MudText>
                </MudStack>
            </MudTd>
            <MudTd>@context.DepartmentName</MudTd>
            <MudTd>@context.RoleTitle</MudTd>
            <MudTd>@context.Email</MudTd>
            <MudTd><StatusChip Status="@context.Status" /></MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" OnClick="@(() => Nav.NavigateTo($"/employees/{context.Id}"))" />
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => Nav.NavigateTo($"/employees/edit/{context.Id}"))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteEmployee(context.Id))" />
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[]{5,10,25,50}" />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    private List<EmployeeListDto> _employees = new();
    private List<Models.Department> _departments = new();
    private List<Models.Role> _roles = new();
    private bool _loading = true;

    private string _searchText = "";
    private string _departmentFilter = "All";
    private string _roleFilter = "All";
    private string _statusFilter = "All";

    private IEnumerable<EmployeeListDto> FilteredEmployees => _employees.Where(e =>
        (string.IsNullOrWhiteSpace(_searchText) ||
            e.FullName.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
            e.Email.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
            e.EmployeeCode.Contains(_searchText, StringComparison.OrdinalIgnoreCase)) &&
        (_departmentFilter == "All" || e.DepartmentName == _departmentFilter) &&
        (_roleFilter == "All" || e.RoleTitle == _roleFilter) &&
        (_statusFilter == "All" || e.Status.ToString() == _statusFilter));

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _employees = await EmployeeService.GetAllAsync();
        _departments = await DepartmentService.GetAllAsync();
        _roles = await RoleService.GetAllAsync();
        _loading = false;
    }

    private async Task DeleteEmployee(int id)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Delete Employee", "Are you sure you want to delete this employee? This cannot be undone.",
            yesText: "Delete", cancelText: "Cancel");

        if (confirmed == true)
        {
            await EmployeeService.DeleteAsync(id);
            Snackbar.Add("Employee deleted successfully", Severity.Success);
            await LoadAsync();
        }
    }
}
